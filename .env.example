# Copy to .env.local for local Docker Compose. Use unique secrets outside development.
ENVIRONMENT=development
RISKLENCE_LOCAL_API_PORT=8000
RISKLENCE_LOCAL_BFF_PORT=8080
RISKLENCE_LOCAL_POSTGRES_PORT=5433
RISKLENCE_LOCAL_MONGODB_PORT=27017
RISKLENCE_LOCAL_REDIS_PORT=6379
RISKLENCE_LOCAL_MAILPIT_SMTP_PORT=1025
RISKLENCE_LOCAL_MAILPIT_HTTP_PORT=8025
# JSON array for FastAPI CORS; add actual browser origins when connecting a separate UI.
RISKLENCE_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# Comma-separated browser origins for the BFF.
BFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
AUTH0_CALLBACK_URL=http://localhost:3000/api/auth/callback
SSO_CALLBACK_URL=http://localhost:3000/auth/sso/callback
