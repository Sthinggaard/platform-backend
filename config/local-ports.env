# Canonical local development port contract.
#
# Change a port here only. Local startup commands, Docker Compose, and the
RISKLENCE_LOCAL_API_PORT=8000
RISKLENCE_LOCAL_BFF_PORT=8080
RISKLENCE_LOCAL_POSTGRES_PORT=5433
RISKLENCE_LOCAL_MONGODB_PORT=27017
RISKLENCE_LOCAL_REDIS_PORT=6379
# Mailpit — the dev mail catcher. Both ports are published on the host so the
# API reaches SMTP whether it runs in Compose (host "mailpit") or as a local
# uvicorn process (host "localhost"), which the verify skill documents as the
# way to test current code against a container that has no source mount.
RISKLENCE_LOCAL_MAILPIT_SMTP_PORT=1025
RISKLENCE_LOCAL_MAILPIT_HTTP_PORT=8025
