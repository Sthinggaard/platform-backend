# Network
BFF_HOST=0.0.0.0
# Local BFF/API ports come from config/local-ports.env.
BFF_UPSTREAM_TIMEOUT_SECONDS=15

# Shared server settings used by the imported tenant middleware during local dev.
# Keep these as development values locally; production must override them explicitly.
ENVIRONMENT=development
AUTH_JWT_SECRET=risklence-dev-only-jwt-secret-do-not-use-in-prod
SECRET_KEY=risklence-dev-only-jwt-secret-do-not-use-in-prod
DEBUG=false

# Limits
BFF_RATE_LIMIT_PER_MINUTE=240

# CORS — comma-separated list of allowed origins (defaults to localhost in dev)
# In production set to your app domain: BFF_ALLOWED_ORIGINS=https://app.risklence.com
BFF_ALLOWED_ORIGINS=

# Metrics — protect /metrics with a Bearer token (leave empty to disable protection in dev)
# In production: BFF_METRICS_TOKEN=<strong-random-secret>
BFF_METRICS_TOKEN=

# Optional: put machine-specific non-port overrides in apps/bff/.env.local.

# TLS (optional)
BFF_SSL_CERTFILE=
BFF_SSL_KEYFILE=
