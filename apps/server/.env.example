# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080"]
SECRET_KEY=change-me-in-production

# Database
DATABASE__POSTGRES_HOST=localhost
DATABASE__POSTGRES_PORT=5432
DATABASE__POSTGRES_USER=risklence
DATABASE__POSTGRES_PASSWORD=risklence_dev_password
DATABASE__POSTGRES_DB=risklence_db
DATABASE__MONGODB_URI=mongodb://localhost:27017
DATABASE__MONGODB_DB=risklence_scans

# Redis / caching
REDIS_URL=redis://localhost:6379/0
ENCRYPTION__ENCRYPTION_KEY=<generate-a-strong-32-byte-fernet-key>

# Optional in development: persist pre-tenant onboarding sessions/tokens to disk (single-instance durability)
# Required in production (pre-tenant verified organisation/profile durability)
# PRETENANT_STORE_FILE=.data/pretenant-store.json
# Activation token security (Epic 3)
# Required in production (hashing secret for stored activation tokens)
# PRETENANT_ACTIVATION_TOKEN_HASH_SECRET=<strong-random-secret>
# Activation token TTL in minutes (recommended 15-60; default 30)
# PRETENANT_ACTIVATION_TOKEN_TTL_MINUTES=30

# Discovery execution evidence storage (Step 4.2, DISC-23/23b)
# Optional in development: falls back to local filesystem storage under
# var/discovery-evidence (or DISCOVERY_EVIDENCE_LOCAL_STORAGE_DIR below) when unset.
# All five must be set together to activate DigitalOcean Spaces — a partial
# config falls back to local filesystem rather than erroring.
# DISCOVERY_EVIDENCE_SPACES_BUCKET=risklence-discovery-evidence
# DISCOVERY_EVIDENCE_SPACES_REGION=ams3
# DISCOVERY_EVIDENCE_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
# DISCOVERY_EVIDENCE_SPACES_KEY=<spaces-access-key-id>
# DISCOVERY_EVIDENCE_SPACES_SECRET=<spaces-secret-access-key>
# DISCOVERY_EVIDENCE_LOCAL_STORAGE_DIR=var/discovery-evidence
# Optional: local CVR stub for public onboarding manual E2E
# PRETENANT_CVR_STUB_ENABLED=true
# Optional: live CVR provider config for Step 2 lookup.
# Provider mode: cvrapi (free/basic) or cvrdev (paid, bearer key).
# PRETENANT_CVR_PROVIDER=cvrapi
# PRETENANT_CVR_PROVIDER_URL=
# PRETENANT_CVR_PROVIDER_METHOD=GET
# PRETENANT_CVR_PROVIDER_TIMEOUT_SECONDS=5
# PRETENANT_CVR_DEFAULT_COUNTRY=DK
# CVR API (https://cvrapi.dk/documentation)
# PRETENANT_CVR_PROVIDER_COUNTRY=dk
# PRETENANT_CVR_PROVIDER_TOKEN=
# PRETENANT_CVR_PROVIDER_USER_AGENT=YourCompany - Risklence Onboarding - ops@example.com
# cvr.dev (https://docs.cvr.dev)
# PRETENANT_CVR_PROVIDER=cvrdev
# PRETENANT_CVR_PROVIDER_API_KEY=
# PRETENANT_CVR_PROVIDER_API_KEY_HEADER=Authorization
# PRETENANT_CVR_PROVIDER_CVR_QUERY_PARAM=cvr_nummer
# Optional: segmentation mapping overrides for org verification (JSON)
# Map two-digit industry prefixes/ranges to industryCluster values.
# Example: {"62-63":"Digital","84":"PublicSector"}
# PRETENANT_SEGMENTATION_INDUSTRY_CLUSTER_PREFIX_MAP_JSON=
# Map legal-form bands to companydesc keyword arrays.
# Example: {"LimitedCompany":["anpart","aps"],"PublicCompany":["aktie","a/s"]}
# PRETENANT_SEGMENTATION_LEGAL_FORM_KEYWORDS_JSON=

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_API_AUDIENCE=
AUTH0_JWKS_URL=
AUTH0_CALLBACK_URL=http://localhost:3000/api/auth/callback
AUTH0_CUSTOM_CLAIMS_NAMESPACE=https://risklence.com/
AUTH0_TESTING_SECRET=

# Local auth + SSO
# Use `poetry run python scripts/generate_jwt_secret.py --env .env.local` to create a strong key.
AUTH_JWT_SECRET=<generate-with-scripts/generate_jwt_secret.py>
SECRET_KEY=<same-as-auth-jwt-secret>
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_ACCESS_TOKEN_TTL=15
AUTH_REFRESH_TOKEN_TTL=30
AUTH_REFRESH_TOKEN_SECRET=
AUTH_REFRESH_COOKIE_NAME=rl_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_PASSWORD_RESET_TTL=30
TEMPLATE_GOVERNANCE_SCHEDULED_TRIGGER_SECRET=
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
# Public origin the scanner CLI (apps/scanner/) connects to directly — never
# the tenant Worker/BFF chain a browser uses. Defaults to production if unset.
SCANNER_API_BASE_URL=http://localhost:8000
SSO_CALLBACK_URL=http://localhost:3000/auth/sso/callback
SSO_STATE_COOKIE_NAME=rl_sso_state
SSO_STATE_TTL=10
SSO_AUTO_LINK=true
SSO_AUTO_PROVISION=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=
SSO_MS_CLIENT_ID=
SSO_MS_CLIENT_SECRET=
SSO_MS_REDIRECT_URI=
SSO_MS_TENANT_MODE=common
EMAIL_FROM=no-reply@risklence.local
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# AI provider (set AI_PROVIDER and the matching key)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview
